# docker-hermes configuration example
# This file can be used with CONFIG_TYPE=file and CONFIG_FILE=path/to/this/file

# Redis connection URL
redis_url: "redis://localhost:6379"

# HTTP server configuration
http_listen_addr: ":8080"
prometheus_sd_path: "/prometheus/sd"

# Agent configuration
docker_socket: "unix:///var/run/docker.sock"
label_prefix: ""  # Empty means all labels, or specify prefix like "hermes."
heartbeat_interval: "30s"
hostname: ""  # Will auto-detect if empty

# Common configuration
http:
  listen_address: ":8080"

tracing:
  enabled: false
  sampler_rate: 1.0
  exporter_endpoint: ""
  exporter_protocol: "grpc"
  exporter_insecure: false
  exporter_headers: {}
